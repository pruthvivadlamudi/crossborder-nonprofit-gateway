# Server Configuration
PORT=3000
NODE_ENV=development

# Trustee Console Security
ADMIN_PASSWORD=SetAStrongPassword2026!
JWT_SECRET=your_jwt_secret_key_here
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/fcra_donations

# PayPal API Credentials (Registered under Business / Sister Entity)
# Mode: 'sandbox' or 'live'
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Entity Profile & Compliance Details (Configurable in production .env)
PRIMARY_TRUST_NAME=Global Charitable Foundation
MANAGING_TRUSTEE=Authorized Managing Trustee
PRIMARY_MERCHANT_EMAIL=trustee@nonprofit.org
PRIMARY_TRUST_PAN=XXXXX0000X
PRIMARY_BANK_NAME=Designated National Bank
PRIMARY_BANK_BRANCH=Main Central Branch
PRIMARY_BANK_IFSC=BANK0000001
PRIMARY_BANK_ACCOUNT_MASKED=XXXXXX0001

# Associated Project Profile
SECONDARY_PROJECT_NAME=Mindful Living Initiative
SECONDARY_MERCHANT_EMAIL=project@nonprofit.org
SECONDARY_TRUST_PAN=YYYYY0000Y
SECONDARY_BANK_NAME=Partner Commercial Bank
SECONDARY_BANK_BRANCH=Regional Metro Branch
SECONDARY_BANK_IFSC=BANK0000002
SECONDARY_BANK_ACCOUNT_MASKED=XXXXXX0002

# Statutory Reporting
FCRA_REGISTRATION_NUMBER=012345678
CURRENT_FINANCIAL_YEAR=2026-2027
DEFAULT_PURPOSE_CODE=P1301
