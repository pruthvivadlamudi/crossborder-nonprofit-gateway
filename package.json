{
  "name": "paypal-fcra-crossborder-engine",
  "version": "2.0.0",
  "description": "Production-grade cross-border non-profit donation gateway for registered charitable trusts and NGOs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/public', 'dist/public', {recursive: true})\"",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [
    "paypal",
    "donations",
    "fcra",
    "fintech",
    "compliance",
    "non-profit",
    "cross-border",
    "trust"
  ],
  "author": "FinTech Systems Architect",
  "license": "MIT",
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.11.6",
    "@types/sqlite3": "^3.1.11",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.12.0",
    "sqlite": "^5.1.1",
    "sqlite3": "5.1.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tar": "^7.5.22",
    "@tootallnate/once": "^3.0.1"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0"
  }
}
